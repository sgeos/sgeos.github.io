---
layout: null
permalink: /feed.json
sitemap: false
---
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | jsonify }},
  "description": {{ site.description | strip_html | strip_newlines | jsonify }},
  "home_page_url": "{{ site.url }}{{ site.baseurl }}/",
  "feed_url": "{{ site.url }}{{ site.baseurl }}/feed.json",
  "language": "en",
  {% if site.author %}
  "authors": [
    {
      "name": {{ site.author | jsonify }}{% if site.author_url %},
      "url": {{ site.author_url | jsonify }}{% endif %}
    }
  ],
  {% endif %}
  "items": [
    {% for post in site.posts limit:30 %}
    {
      "id": "{{ site.url }}{{ site.baseurl }}{{ post.url }}",
      "url": "{{ site.url }}{{ site.baseurl }}{{ post.url }}",
      "title": {{ post.title | jsonify }},
      "content_html": {{ post.content | jsonify }},
      "summary": {{ post.excerpt | default: post.description | strip_html | strip_newlines | truncate: 240 | jsonify }},
      "date_published": "{{ post.date | date_to_xmlschema }}",
      "tags": [{% for cat in post.categories %}{{ cat | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}]
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
