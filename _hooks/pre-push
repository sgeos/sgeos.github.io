#!/bin/sh
# pre-push: run the corpus invariant checks before anything reaches the remote.
#
# _verify.py takes about a minute, most of it checking the 372 articles whose
# References sections are generated from the 154 MB source database. It took
# about fifty minutes before 2026-10-30, when the database was reloaded for each
# post, and this comment still claimed three seconds. A CI rejection takes far
# longer, because the deploy installs a TeX toolchain and regenerates downloads.
#
# Enable once per clone:
#     git config core.hooksPath _hooks
#
# Bypass for a single push when you know better:
#     git push --no-verify

if ! command -v python3 > /dev/null 2>&1; then
    printf '%s\n' "pre-push: python3 not found, skipping corpus checks." >&2
    exit 0
fi

printf '%s\n' "pre-push: verifying corpus invariants..."
if ! python3 "$(git rev-parse --show-toplevel)/_verify.py" --quiet; then
    printf '%s\n' "" >&2
    printf '%s\n' "pre-push: corpus checks FAILED. Push aborted." >&2
    printf '%s\n' "Fix the errors above, or push with --no-verify to override." >&2
    exit 1
fi
printf '%s\n' "pre-push: corpus checks passed."
exit 0
