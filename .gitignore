# jekyll
_site
.sass-cache
.jekyll-metadata
.jekyll-cache

# bundler (local gem install path and config, if a local bundle is ever used)
vendor/
.bundle/

# vim
*~
*.swp
*.swo

# drafts not worth commiting
hidden.*.markdown

# Generated download cache, populated by _downloads.rb
.cache/

# Project-local temporary files
secret/*
tmp/*

# Whitelist .gitkeep files globally.
!.gitkeep

# Python bytecode. A compiled .pyc under __pycache__ is already tracked from
# before this rule; it is left in place rather than untracked here, since
# removing tracked files is a separate decision.
__pycache__/
*.pyc
